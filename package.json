{
  "name": "oficina-erp",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.node.json --noEmit && vite build",
    "build:web": "tsc && tsc -p tsconfig.node.json --noEmit && vite build --mode cloud",
    "build:web:real": "tsc && tsc -p tsconfig.node.json --noEmit && vite build --mode real",
    "deploy:web:real": "npm run build:web:real && npx wrangler pages deploy dist --project-name andersonmecanica --branch main",
    "tauri:build:real": "tauri build --config scripts/tauri.nuvem-real.json",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "vehicles:build": "node scripts/build-vehicle-catalog.mjs",
    "test:db": "node scripts/test-db.mjs",
    "build:functions": "tsc -p tsconfig.functions.json --noEmit && node scripts/build-functions.mjs",
    "test:functions": "node scripts/test-functions.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.109.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2.5.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.5.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "fake-indexeddb": "6.2.8",
    "postgres": "^3.4.5",
    "supabase": "^3.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-imagemin": "^0.6.1",
    "vitest": "^3.2.7"
  }
}
