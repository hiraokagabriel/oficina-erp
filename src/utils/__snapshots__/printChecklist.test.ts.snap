exports[`buildPrintChecklistHtml: snapshots > completo 1`] = `
"
    <!DOCTYPE html>
    <html lang="pt-BR">
    <head>
      <meta charset="UTF-8">
      <title>Checklist_OS77_Fiat_Uno_ABC_1D23</title>
      <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        @page {
          size: A4;
          margin: 12mm 12mm 16mm 12mm;
          @bottom-left {
            content: "Checklist de vistoria \\00B7 OS 77 \\00B7 ABC-1D23";
            font-family: 'Inter', Arial, sans-serif;
            font-size: 8pt;
            color: #444444;
          }
          @bottom-right {
            content: "Página " counter(page) " de " counter(pages);
            font-family: 'Inter', Arial, sans-serif;
            font-size: 8pt;
            color: #444444;
          }
        }

        body {
          font-family: 'Inter', Arial, sans-serif;
          background: #ffffff;
          color: #111111;
          font-size: 9pt;
          line-height: 1.3;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }
        .mono {
          font-family: "Cascadia Mono", Consolas, monospace;
          font-variant-numeric: tabular-nums;
        }

        /* ---- Barra de título ---- */
        .title-bar {
          display: flex;
          justify-content: space-between;
          align-items: flex-end;
          gap: 8mm;
          padding-bottom: 2mm;
          border-bottom: 1.5pt solid #000000;
          margin-bottom: 3mm;
        }
        .shop-name { font-size: 13pt; font-weight: 700; color: #000000; }
        .shop-sub { font-size: 8.5pt; color: #444444; }
        .title-right { text-align: right; }
        .doc-title { font-size: 11pt; font-weight: 700; text-transform: uppercase; color: #000000; }
        .doc-os { font-size: 14pt; font-weight: 700; color: #000000; }
        .doc-mode { font-size: 9pt; color: #333333; }

        /* ---- Grade de campos ---- */
        table.fields { width: 100%; border-collapse: collapse; table-layout: fixed; margin-bottom: 3mm; }
        td.fld { border: 0.5pt solid #000000; padding: 1mm 2mm; height: 12mm; vertical-align: top; }
        .fld-l { font-size: 8pt; text-transform: uppercase; color: #444444; }
        .fld-v { font-size: 10pt; color: #111111; overflow-wrap: anywhere; }

        /* ---- Resumo ---- */
        .summary-line { font-size: 9pt; color: #111111; }
        .hint-line { font-size: 9pt; color: #333333; margin-bottom: 3mm; }
        .summary-line { margin-bottom: 0.5mm; }
        .empty { font-size: 9pt; color: #333333; margin: 4mm 0; }

        /* ---- Itens em duas colunas ---- */
        .items { columns: 2; column-gap: 8mm; margin-bottom: 4mm; }
        table.cat { width: 100%; border-collapse: collapse; table-layout: fixed; margin-bottom: 3mm; }
        table.cat col.c-st { width: 13mm; }
        table.cat-small { break-inside: avoid; page-break-inside: avoid; }
        thead { display: table-header-group; }
        thead tr { break-after: avoid; page-break-after: avoid; }
        tr { break-inside: avoid; page-break-inside: avoid; }
        th.cat-name {
          border-top: 1pt solid #000000;
          border-bottom: 0.5pt solid #000000;
          padding: 1mm 1mm 0.5mm 0;
          font-size: 9pt;
          font-weight: 700;
          text-align: left;
          vertical-align: bottom;
          color: #000000;
        }
        th.colh {
          border-top: 1pt solid #000000;
          border-bottom: 0.5pt solid #000000;
          padding: 1mm 0.3mm 0.5mm 0.3mm;
          font-size: 8pt;
          font-weight: 700;
          line-height: 1.15;
          text-align: center;
          vertical-align: bottom;
          color: #000000;
        }
        td.lbl { padding: 0.8mm 1mm 0.8mm 0; border-bottom: 0.5pt solid #8c8c8c; font-size: 9pt; vertical-align: middle; overflow-wrap: anywhere; }
        td.lbl.is-urgent { font-weight: 700; }
        .item-note { font-size: 8.5pt; color: #333333; white-space: pre-wrap; margin-top: 0.3mm; font-weight: 400; }
        td.st { border-bottom: 0.5pt solid #8c8c8c; text-align: center; vertical-align: middle; padding: 0.8mm 0; }
        svg.box { width: 3.6mm; height: 3.6mm; display: inline-block; vertical-align: middle; }

        /* ---- Bloco de notas ---- */
        .notes { break-inside: avoid; page-break-inside: avoid; margin-bottom: 4mm; }
        .sec-title {
          border-top: 1pt solid #000000;
          padding-top: 1mm;
          margin-bottom: 1.5mm;
          font-size: 9pt;
          font-weight: 700;
          text-transform: uppercase;
          color: #000000;
        }
        .notes-text { font-size: 9pt; color: #111111; white-space: pre-wrap; overflow-wrap: anywhere; }
        .rule { height: 7mm; border-bottom: 0.5pt solid #8c8c8c; }

        /* ---- Assinaturas ---- */
        .sign-block { break-inside: avoid; page-break-inside: avoid; break-before: avoid-page; page-break-before: avoid; margin-top: 4mm; }
        .signatures { display: flex; gap: 10mm; }
        .signature { flex: 1; }
        .sign-line { height: 15mm; border-bottom: 0.75pt solid #000000; }
        .sign-name { font-size: 10pt; color: #111111; margin-top: 1mm; overflow-wrap: anywhere; }
        .sign-label { font-size: 8pt; text-transform: uppercase; color: #444444; }
        .place-date { font-size: 9pt; margin-top: 4mm; color: #111111; }
        .declaration { font-size: 9pt; margin-top: 4mm; color: #111111; }
        .thanks { font-size: 9pt; font-weight: 700; margin-top: 1mm; color: #000000; }
      </style>
    </head>
    <body>

      <div class="title-bar">
        <div>
          <div class="shop-name">Oficina Teste</div>
          <div class="shop-sub">Rua das Flores, 100 - Centro</div>
          <div class="shop-sub">CNPJ: 12.345.678/0001-90</div>
        </div>
        <div class="title-right">
          <div class="doc-title">Checklist de vistoria do veículo</div>
          <div class="doc-os mono">OS Nº 77</div>
          
        </div>
      </div>

      <table class="fields">
        <tr><td colspan="8" class="fld "><div class="fld-l">Cliente</div><div class="fld-v">João da Silva</div></td><td colspan="4" class="fld "><div class="fld-l">Telefone</div><div class="fld-v">(11) 99999-0000</div></td></tr>
        <tr><td colspan="6" class="fld "><div class="fld-l">Veículo (modelo)</div><div class="fld-v">Fiat Uno</div></td><td colspan="3" class="fld "><div class="fld-l">Placa</div><div class="fld-v"><span class="mono">ABC-1D23</span></div></td><td colspan="3" class="fld "><div class="fld-l">KM de entrada</div><div class="fld-v"><span class="mono">85.100 km</span></div></td></tr>
        <tr><td colspan="8" class="fld "><div class="fld-l">Responsável técnico</div><div class="fld-v">Carlos</div></td><td colspan="4" class="fld "><div class="fld-l">Data da vistoria</div><div class="fld-v">10/03/2026</div></td></tr>
      </table>

      <p class="summary-line">Inspecionados: 3 de 4 &middot; OK / Feito: 1 &middot; Necessita trocar: 1 &middot; <strong>Urgente!: 1</strong></p>
      <p class="hint-line">Marque com X a coluna do estado. Três caixas vazias = item não inspecionado.</p>

      <div class="items"><table class="cat cat-small">
    <colgroup><col><col class="c-st"><col class="c-st"><col class="c-st"></colgroup>
    <thead><tr><th class="cat-name">FREIOS</th><th class="colh">OK / Feito</th><th class="colh">Necessita trocar</th><th class="colh">Urgente!</th></tr></thead>
    <tbody><tr><td class="lbl">Pastilhas dianteiras<div class="item-note">Observação: Desgaste de 80%</div></td><td class="st st-ok"><svg class="box" viewBox="0 0 12 12" aria-hidden="true"><rect x="0.5" y="0.5" width="11" height="11" fill="none" stroke="#000000" stroke-width="1"/></svg></td><td class="st st-attention is-marked"><svg class="box" viewBox="0 0 12 12" aria-hidden="true"><rect x="0.5" y="0.5" width="11" height="11" fill="none" stroke="#000000" stroke-width="1"/><path d="M3 3l6 6M9 3l-6 6" fill="none" stroke="#000000" stroke-width="1.6"/></svg></td><td class="st st-urgent"><svg class="box" viewBox="0 0 12 12" aria-hidden="true"><rect x="0.5" y="0.5" width="11" height="11" fill="none" stroke="#000000" stroke-width="1"/></svg></td></tr><tr><td class="lbl">Fluido de freio</td><td class="st st-ok is-marked"><svg class="box" viewBox="0 0 12 12" aria-hidden="true"><rect x="0.5" y="0.5" width="11" height="11" fill="none" stroke="#000000" stroke-width="1"/><path d="M3 3l6 6M9 3l-6 6" fill="none" stroke="#000000" stroke-width="1.6"/></svg></td><td class="st st-attention"><svg class="box" viewBox="0 0 12 12" aria-hidden="true"><rect x="0.5" y="0.5" width="11" height="11" fill="none" stroke="#000000" stroke-width="1"/></svg></td><td class="st st-urgent"><svg class="box" viewBox="0 0 12 12" aria-hidden="true"><rect x="0.5" y="0.5" width="11" height="11" fill="none" stroke="#000000" stroke-width="1"/></svg></td></tr><tr><td class="lbl">Discos</td><td class="st st-ok"><svg class="box" viewBox="0 0 12 12" aria-hidden="true"><rect x="0.5" y="0.5" width="11" height="11" fill="none" stroke="#000000" stroke-width="1"/></svg></td><td class="st st-attention"><svg class="box" viewBox="0 0 12 12" aria-hidden="true"><rect x="0.5" y="0.5" width="11" height="11" fill="none" stroke="#000000" stroke-width="1"/></svg></td><td class="st st-urgent"><svg class="box" viewBox="0 0 12 12" aria-hidden="true"><rect x="0.5" y="0.5" width="11" height="11" fill="none" stroke="#000000" stroke-width="1"/></svg></td></tr></tbody>
  </table><table class="cat cat-small">
    <colgroup><col><col class="c-st"><col class="c-st"><col class="c-st"></colgroup>
    <thead><tr><th class="cat-name">MOTOR</th><th class="colh">OK / Feito</th><th class="colh">Necessita trocar</th><th class="colh">Urgente!</th></tr></thead>
    <tbody><tr><td class="lbl is-urgent">Correia dentada</td><td class="st st-ok"><svg class="box" viewBox="0 0 12 12" aria-hidden="true"><rect x="0.5" y="0.5" width="11" height="11" fill="none" stroke="#000000" stroke-width="1"/></svg></td><td class="st st-attention"><svg class="box" viewBox="0 0 12 12" aria-hidden="true"><rect x="0.5" y="0.5" width="11" height="11" fill="none" stroke="#000000" stroke-width="1"/></svg></td><td class="st st-urgent is-marked"><svg class="box" viewBox="0 0 12 12" aria-hidden="true"><rect x="0.5" y="0.5" width="11" height="11" fill="none" stroke="#000000" stroke-width="1"/><path d="M3 3l6 6M9 3l-6 6" fill="none" stroke="#000000" stroke-width="1.6"/></svg></td></tr></tbody>
  </table></div>

      <section class="notes">
        <div class="sec-title">Observações gerais</div>
        <div class="notes-text">Risco na porta direita.</div>
        <div class="rule"></div><div class="rule"></div><div class="rule"></div>
      </section>

      <div class="sign-block">
        <div class="signatures">
          <div class="signature">
            <div class="sign-line"></div>
            <div class="sign-name">Carlos</div>
            <div class="sign-label">Responsável técnico</div>
